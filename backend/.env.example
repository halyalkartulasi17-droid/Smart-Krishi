# Smart KRISHI (SmartAI Kisan) Backend Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=smart-krishi-jwt-super-secret-key-2026-secure
DATABASE_URL=sqlite:///smart_krishi.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/smart_krishi_db

PORT=5000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional AI provider keys for Kisan Mitra (OpenAI, Gemini, Claude).
# If empty, built-in intelligent agricultural expert rule engine and knowledge base is used.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Open-Meteo Weather API (free, open, no key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Agmarknet / data.gov.in configuration
DATA_GOV_IN_API_KEY=

